# ─── GitHub ───
GITHUB_WEBHOOK_SECRET=dev_secret_change_in_prod
GITHUB_TOKEN=ghp_YOUR_FINE_GRAINED_PAT

# ─── DeepSeek V4 Flash ───
DEEPSEEK_API_KEY=sk-YOUR_DEEPSEEK_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# ─── Jev (TypeSafe AI) ───
TYPESAFE_API_KEY=sk-xxxx
# Alias also accepted: JEV_API_KEY
JEV_MODEL=jev-1.13.0

# ─── App ───
APP_PORT=8000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
DATABASE_PATH=./sentinel.db
LOG_LEVEL=debug

# ─── Discord ───
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CHANNEL_ID=your_channel_id
DISCORD_GUILD_ID=your_guild_id
DISCORD_OWNER_ID=your_discord_user_id

# ─── Cursor SDK ───
CURSOR_API_KEY=crsr_your_api_key
CURSOR_DEFAULT_MODEL=claude-sonnet-4-20250514
